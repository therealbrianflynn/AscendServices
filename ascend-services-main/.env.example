# Copy to .env for local non-Docker next dev (optional).
# Docker Compose injects these for the app service.
# Placeholders only — never commit real secrets.

# Postgres connection string used by Prisma
DATABASE_URL="postgresql://ascend:ascend@localhost:5432/ascend_services?schema=public"

# App
NODE_ENV=development
PORT=3000
# Absolute origin used to build magic links and the post-sign-in redirect
APP_BASE_URL="http://localhost:3000"

# Auth (passwordless magic link -> signed httpOnly session cookie)
# Generate your own: openssl rand -base64 48
AUTH_SESSION_SECRET="replace-me-with-openssl-rand-base64-48-at-least-32-chars"
AUTH_SESSION_TTL_HOURS=24
MAGIC_LINK_TTL_MINUTES=15

# Passkeys (WebAuthn). Both default to APP_BASE_URL, which is what you want
# locally; set them explicitly once the app answers on a real domain.
# RP ID = bare registrable host, no scheme/port. It must equal the origin host
# or one of its parent domains, or browsers refuse the ceremony.
# WEBAUTHN_RP_ID="ascend.example"
# Comma-separated absolute origins allowed to complete a ceremony.
# WEBAUTHN_ORIGINS="https://ascend.example,https://www.ascend.example"
# Name the authenticator shows in its prompt.
# WEBAUTHN_RP_NAME="Ascend Services"
# How long a challenge stays redeemable. Challenges are single-use and stored
# server-side, so this only bounds how long a half-finished prompt is valid.
# WEBAUTHN_CHALLENGE_TTL_MINUTES=5

# Email: seed MVP has no paid SMTP. "log" writes each message to the
# structured JSON log instead of sending it.
EMAIL_TRANSPORT=log
EMAIL_FROM="no-reply@ascend.local"
# Log the rendered body (contains the magic link). Defaults to true outside
# production; force it off if local logs are shipped anywhere shared.
# EMAIL_LOG_INCLUDE_BODY=true

# Request Help form: comma-separated catalogue of help categories offered by
# the public form. Unset falls back to the seed-MVP list in
# `src/lib/requests/service-types.ts`.
# REQUEST_SERVICE_TYPES="Yard work,Home repair,Moving help,Transportation,Meals,Errands or shopping,Technology help,Other"

# SLA monitor (`pnpm sla:check`, or POST /api/admin/sla/monitor).
# Thresholds themselves live in SystemSettings and are edited in /admin.
# Set to false to keep the SLA_BREACH log lines but stop the admin digest email.
# SLA_ADMIN_NOTIFY=true

# One-time ADMIN bootstrap for `pnpm db:seed:admin`
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_NAME="Ascend Admin"
